<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:paddingTop="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Domek w górach"
        android:textSize="25sp"
        />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:src="@drawable/domek"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#008080"
        >

        <Button
            android:id="@+id/przycisk_polub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#008080"
            android:textColor="@color/white"
            android:text="POLUB"
            />

        <Button
            android:id="@+id/przycisk_usun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#008080"
            android:textColor="@color/white"
            android:text="USUŃ"
            />

        <Button
            android:id="@+id/przycisk_zapisz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#008080"
            android:textColor="@color/white"
            android:text="ZAPISZ"
            />

        <Button
            android:id="@+id/przycisk_umow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Umów"
            android:background="#008080"
            android:textColor="@color/white"
            />

        <Button
            android:id="@+id/przycisk_o_nas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="O nas"
            android:background="#008080"
            android:textColor="@color/white"
            />

    </LinearLayout>

    <TextView
        android:id="@+id/polubienia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 polubień"
        android:textColor="#808080"
        android:layout_gravity="right"
        />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#808080"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Opis"
        android:textStyle="bold"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Odwiedź komfortowy domek w Sudetach, blisko do szlaków turystycznych"
        />



</LinearLayout>